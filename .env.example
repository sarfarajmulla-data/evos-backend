# Application
APP_ENV=development
APP_NAME=EVOS Backend
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Frontend / CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database / Supabase
DATABASE_URL=sqlite:///./evos.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dataset access / timeouts
DATASET_TIMEOUT_SECONDS=30
ACN_USERNAME=
ACN_PASSWORD=
ELAADNL_API_KEY=
PECAN_STREET_API_KEY=
NASA_POWER_API_KEY=

# Authentication / security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Simulation defaults
DEFAULT_SIMULATION_HORIZON_HOURS=24
DEFAULT_GRID_IMPORT_LIMIT_KW=80
DEFAULT_BATTERY_CAPACITY_KWH=100
DEFAULT_BATTERY_RESERVE_PERCENT=20

# Logging
LOG_LEVEL=INFO
